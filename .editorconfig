# EditorConfig — base style for Kotlin/Compose. ktlint reads it directly.
# https://editorconfig.org/  ·  https://ktlint.github.io/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Style: ktlint_official | intellij_idea | android_studio
ktlint_code_style = android_studio
max_line_length = 120
# Jetpack Compose: @Composable/@Preview functions use PascalCase.
# Instead of disabling the naming rule, tell it to ignore those
# annotations (ktlint >= 1.0). The rest of the functions are still validated.
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview
# Compose files often have several top-level functions (Theme.kt,
# Color.kt...), so the filename rule is relaxed.
ktlint_standard_filename = disabled
# No trailing comma (aesthetics): ktlint removes and forbids it.
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
# Forbids ALL wildcard imports (import x.*): no package exempt.
# Enforced by ktlint at build time (ktlintCheck), not just in the editor.
ij_kotlin_packages_to_use_import_on_demand = unset
# Prevents Android Studio/IntelliJ from collapsing imports into a wildcard
# while typing (very high threshold = never use star import). Complements the ktlint rule.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
