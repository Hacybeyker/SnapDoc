<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint configuration.
  https://developer.android.com/studio/write/lint
  Adjusts severity per issue: ignore | information | warning | error | fatal
-->
<lint>
    <!-- Don't abort the build on deprecations; flag them as a warning instead. -->
    <issue id="Deprecation" severity="warning" />
    <issue id="GradleDependency" severity="warning" />
    <issue id="OldTargetApi" severity="warning" />

    <!-- Quality recommendations as an error in our own code. -->
    <issue id="VisibleForTests" severity="error" />

    <!-- Common noise that can be silenced. -->
    <issue id="UnusedResources" severity="warning" />

    <!-- Exclude generated code/test resources. -->
    <issue id="all">
        <ignore path="**/build/**" />
    </issue>
</lint>
