<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below.

    The app's promise is that documents do not leave the phone, and cloud backup is a way for them to
    leave it: the pages live in filesDir/scans and their recognized text lives in the Room database,
    so an unrestricted backup would copy someone's receipts and IDs into their Google account. Every
    domain that can hold document data is excluded; there is nothing else worth backing up.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
