<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for API 31 and above, where the two are configured separately — which is
    what lets them be answered differently.

    Cloud backup: nothing. Scanned pages and the text read off them are exactly what this app promises
    never leaves the device, and a Google account backup is off the device.

    Device-to-device transfer: everything. Moving to a new phone is a direct handover between two
    devices the same person is holding, so the archive travels with them instead of being lost.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
