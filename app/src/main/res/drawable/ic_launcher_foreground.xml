<?xml version="1.0" encoding="utf-8"?>
<!--
  A page with the scan light crossing it. The beam overshoots the document on both sides, which is
  what makes it read as light passing over the page rather than a line printed on it.

  The whole mark stays inside the 66dp safe circle: the page corners sit 31 units from the centre and
  the beam's round caps 31, against a radius of 33, so no launcher mask can clip either.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The document, with the corner turned. Deep navy so it holds against the amber behind it. -->
    <path
        android:fillColor="#FF0E1B3D"
        android:pathData="M41,28H59L71,40V76A4,4 0 0 1 67,80H41A4,4 0 0 1 37,76V32A4,4 0 0 1 41,28Z" />
    <path
        android:fillColor="#FF3A4E86"
        android:pathData="M59,28L71,40H59Z" />

    <!-- Two lines of text, quiet enough that the beam stays the subject. -->
    <path
        android:pathData="M44,48H62"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,64H57"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />

    <!-- The beam: a soft pass under a hard core, so it reads as light and not as a white bar. -->
    <path
        android:pathData="M29,56H79"
        android:strokeColor="#38FFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round" />
    <path
        android:pathData="M29,56H79"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
