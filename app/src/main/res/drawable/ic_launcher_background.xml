<?xml version="1.0" encoding="utf-8"?>
<!--
  Amber, not the product blue. A home screen is mostly blue and white icons; the app the user opens
  to photograph something has to be findable in that grid, and inverting the palette is what makes it
  so. The blue comes back as the document sitting on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FFFFC24A" android:offset="0.0" />
                <item android:color="#FFE8801B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
